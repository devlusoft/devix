{
  "name": "devix-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the devix framework and its packages",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm --filter @devlusoft/devix build",
    "dev": "pnpm --filter playground dev",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
