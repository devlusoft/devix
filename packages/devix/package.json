{
  "name": "@devlusoft/devix",
  "version": "0.9.0-alpha.1",
  "type": "module",
  "description": "A lightweight Solid SSR meta-framework — devix",
  "author": "devlusoft",
  "license": "MIT",
  "homepage": "https://github.com/devlusoft/devix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlusoft/devix.git"
  },
  "keywords": [
    "solid",
    "solid-js",
    "ssr",
    "meta-framework",
    "vite",
    "devix",
    "devlusoft"
  ],
  "files": [
    "dist",
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "default": "./lib/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.50"
  },
  "peerDependencies": {
    "solid-js": "2.0.0-rc.15",
    "@solidjs/web": "2.0.0-rc.15",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@solidjs/web": "2.0.0-rc.15",
    "@types/node": "25.5.0",
    "solid-js": "2.0.0-rc.15",
    "tsdown": "0.22.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
